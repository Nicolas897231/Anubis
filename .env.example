APP_URL=https://anubis.snti.local
# Preferred runtime variables for Ubuntu/Docker. Use only a publishable key.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
# Server-only recovery context signing key: generate 32 random bytes as 64 hex characters.
# Keep stable across container restarts. Never use NEXT_PUBLIC_ or commit the real value.
AUTH_RECOVERY_SECRET=
# Optional browser/build-time compatibility variables. Not needed by Phase 1 SSR.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
