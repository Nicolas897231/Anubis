# Copy to .env.lab on Ubuntu only. Never commit .env.lab.
# From local Supabase status: Publishable key, or legacy anon, NEVER secret/service_role.
ANUBIS_LAB_PUBLISHABLE_KEY=
# Inspect the local gateway container and its internal HTTP port, not the host port.
# Example only (verify actual name): supabase_kong_anubis:8000
ANUBIS_LAB_API_UPSTREAM=
